# Ignore the entire build directory
/bin/
/build/

# Ignore object files and other binaries
*.o
spinlock_test
spinlock_test_trace

# Ignore shared library files
*.so
*.a

# GDB / pwndbg artifacts
core
core.*
gdb.txt
.gdb_history
peda-session-*.txt

# Valgrind artifacts
vgcore.*
callgrind.out.*
cachegrind.out.*
massif.out.*
helgrind.out.*

# strace, ltrace, uftrace artifacts
strace.out
strace.log
*.strace
ltrace.out
ltrace.log
*.ltrace
uftrace.data/

# CMake in-source residue (out-of-source builds go in /build/ above)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# Python bytecode and tooling caches
__pycache__/
*.pyc
*.pyo
.mypy_cache/
.ruff_cache/

# perf / flamegraph / gprof artifacts
perf.data
perf.data.old
flamegraph.svg
gmon.out

# LSP / Editor artifacts
compile_commands.json
.cache/

# AI Tool Artifacts
.claude/
CLAUDE.md
