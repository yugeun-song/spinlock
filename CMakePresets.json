{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "environment": {
        "CFLAGS": "",
        "LDFLAGS": "",
        "CMAKE_TOOLCHAIN_FILE": "",
        "CCC_OVERRIDE_OPTIONS": "#",
        "CL": "",
        "_CL_": "",
        "LINK": "",
        "_LINK_": ""
      },
      "cacheVariables": {
        "EXPECTED_PRESET": "${presetName}"
      }
    },
    {
      "name": "linux",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "x86_64-linux-gcc",
      "inherits": "linux",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc"
      }
    },
    {
      "name": "x86_64-linux-clang",
      "inherits": "linux",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang"
      }
    },
    {
      "name": "aarch64-linux-gcc",
      "inherits": "linux",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_SYSTEM_PROCESSOR": "aarch64",
        "CMAKE_C_COMPILER": "aarch64-linux-gnu-gcc",
        "CMAKE_CROSSCOMPILING_EMULATOR": "qemu-aarch64;-L;/usr/aarch64-linux-gnu"
      }
    },
    {
      "name": "aarch64-linux-clang",
      "inherits": "linux",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_SYSTEM_PROCESSOR": "aarch64",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_C_COMPILER_TARGET": "aarch64-linux-gnu",
        "CMAKE_SYSROOT": "/usr/aarch64-linux-gnu",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld",
        "CMAKE_CROSSCOMPILING_EMULATOR": "qemu-aarch64;-L;/usr/aarch64-linux-gnu"
      }
    }
  ]
}
