execute_process(COMMAND ${EMULATOR} "${BENCH}" -t 4 -l 0 -i 50000 OUTPUT_VARIABLE out RESULT_VARIABLE status)
string(REGEX MATCHALL "Atomic Count[^\n]*" counts "${out}")
list(LENGTH counts total)
set(ok 0)
foreach(line IN LISTS counts)
    if(line MATCHES "\\(OK\\)$")
        math(EXPR ok "${ok} + 1")
    endif()
endforeach()
if(NOT status EQUAL 0 OR total EQUAL 0 OR NOT ok EQUAL total)
    message("${out}")
    message(FATAL_ERROR "benchmark smoke run failed: exit status ${status}, ${ok} of ${total} atomic counts OK")
endif()
message("benchmark smoke run passed: ${ok} of ${total} atomic counts OK")
