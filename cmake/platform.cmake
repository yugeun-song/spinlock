include(CheckCSourceCompiles)
include(CheckSymbolExists)
set(CMAKE_REQUIRED_QUIET ON)

function(report label)
    list(JOIN ARGN " " text)
    set_property(GLOBAL APPEND PROPERTY CONFIGURE_REPORT "=> ${label}: ${text}")
endfunction()

function(flush_report)
    get_property(lines GLOBAL PROPERTY CONFIGURE_REPORT)
    list(JOIN lines "\n" text)
    string(MD5 report_id "${text}")
    if(NOT report_id STREQUAL "$CACHE{REPORT_HASH}")
        message(NOTICE "${text}")
        set(REPORT_HASH ${report_id} CACHE INTERNAL "")
    endif()
endfunction()

file(REAL_PATH "${CMAKE_C_COMPILER}" compiler_file)
file(TIMESTAMP "${compiler_file}" compiler_stamp "%s")
string(MD5 toolchain_id "${compiler_file} ${compiler_stamp} ${CMAKE_C_COMPILER_TARGET} ${CMAKE_SYSROOT} ${CMAKE_C_FLAGS} ${CMAKE_EXE_LINKER_FLAGS}")
if(NOT toolchain_id STREQUAL "$CACHE{TOOLCHAIN_HASH}")
    if(DEFINED CACHE{TOOLCHAIN_HASH})
        report("toolchain" "changed since the last configure, probed again")
    endif()
    get_property(cached DIRECTORY PROPERTY CACHE_VARIABLES)
    list(FILTER cached INCLUDE REGEX "^(ARCH_IS_|ACCEPTS_|LINKS_|HAVE_|GCC_VERSION_MATCHES$|LTO_SUPPORTED$)")
    foreach(entry IN LISTS cached)
        unset(${entry} CACHE)
    endforeach()
    set(TOOLCHAIN_HASH ${toolchain_id} CACHE INTERNAL "")
endif()

if(NOT DEFINED SUPPORTED_OSES)
    set(SUPPORTED_OSES Linux Windows)
endif()
if(NOT DEFINED SUPPORTED_ARCHES)
    set(SUPPORTED_ARCHES x86_64 aarch64 riscv64)
endif()
if(NOT CMAKE_SYSTEM_NAME IN_LIST SUPPORTED_OSES)
    list(JOIN SUPPORTED_OSES ", " oses_text)
    message(FATAL_ERROR "unsupported target OS '${CMAKE_SYSTEM_NAME}'; this project targets ${oses_text}")
endif()
string(TOLOWER "${CMAKE_SYSTEM_NAME}" TARGET_OS)

if(CMAKE_C_COMPILER_ID STREQUAL "GNU")
    execute_process(COMMAND "${CMAKE_C_COMPILER}" -dumpfullversion OUTPUT_VARIABLE gcc_version ERROR_QUIET)
    string(REGEX MATCH "^([0-9]+)\\.([0-9]+)" gcc_version "${gcc_version}")
    check_c_source_compiles("#if __GNUC__ != ${CMAKE_MATCH_1}+0 || __GNUC_MINOR__ != ${CMAKE_MATCH_2}+0\n#error\n#endif\nint main(void) { return 0; }" GCC_VERSION_MATCHES)
endif()
if(CMAKE_C_COMPILER_ID STREQUAL "GNU" AND GCC_VERSION_MATCHES)
    set(TARGET_CC gcc)
    set(FLAG_SYNTAX gnu)
elseif(CMAKE_C_COMPILER_ID STREQUAL "Clang" AND CMAKE_C_COMPILER_FRONTEND_VARIANT STREQUAL "GNU")
    set(TARGET_CC clang)
    set(FLAG_SYNTAX gnu)
elseif(CMAKE_C_COMPILER_ID STREQUAL "Clang" AND CMAKE_C_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
    set(TARGET_CC clang)
    set(FLAG_SYNTAX msvc)
elseif(CMAKE_C_COMPILER_ID STREQUAL "MSVC")
    set(TARGET_CC msvc)
    set(FLAG_SYNTAX msvc)
else()
    message(FATAL_ERROR "${CMAKE_C_COMPILER} is not GCC, Clang or MSVC (CMake ID '${CMAKE_C_COMPILER_ID}' ${CMAKE_C_COMPILER_VERSION})")
endif()
get_filename_component(compiler_name "${CMAKE_C_COMPILER}" NAME)
if(TARGET_OS STREQUAL "linux" AND NOT FLAG_SYNTAX STREQUAL "gnu")
    message(FATAL_ERROR "linux builds use GCC or Clang, not ${compiler_name}")
elseif(TARGET_OS STREQUAL "windows" AND NOT FLAG_SYNTAX STREQUAL "msvc")
    message(FATAL_ERROR "windows builds use MSVC or clang-cl, not ${compiler_name}")
endif()
set(KNOWN_DIALECTS gcc clang msvc gnu)
set(C_DIALECTS ${TARGET_CC} ${FLAG_SYNTAX})
list(REMOVE_DUPLICATES C_DIALECTS)

set(arch_predicates
    x86_64 "defined(__x86_64__) || defined(_M_X64)"
    aarch64 "defined(__aarch64__) || defined(_M_ARM64)"
    riscv64 "defined(__riscv) && __riscv_xlen == 64"
)
set(TARGET_ARCH "")
while(arch_predicates)
    list(POP_FRONT arch_predicates arch predicate)
    check_c_source_compiles("#if !(${predicate})\n#error\n#endif\nint main(void) { return 0; }" ARCH_IS_${arch})
    if(ARCH_IS_${arch} AND arch IN_LIST SUPPORTED_ARCHES)
        list(APPEND TARGET_ARCH ${arch})
    endif()
endwhile()
list(LENGTH TARGET_ARCH arch_count)
if(NOT arch_count EQUAL 1)
    list(JOIN SUPPORTED_ARCHES ", " arches_text)
    message(FATAL_ERROR "unsupported target architecture; this project targets ${arches_text}")
endif()
if(TARGET_OS STREQUAL "windows" AND NOT TARGET_ARCH STREQUAL "x86_64")
    message(FATAL_ERROR "unsupported combination: windows on ${TARGET_ARCH}; windows builds target x86_64 only")
endif()

set(TARGET_NAME ${TARGET_ARCH}-${TARGET_OS}-${TARGET_CC})
if(EXPECTED_PRESET AND NOT EXPECTED_PRESET STREQUAL TARGET_NAME)
    message(FATAL_ERROR "preset ${EXPECTED_PRESET} resolved to ${TARGET_NAME}")
endif()

check_symbol_exists(__GLIBC__ "features.h" HAVE_GLIBC)
set(CMAKE_REQUIRED_DEFINITIONS -D_POSIX_C_SOURCE=199309L)
check_symbol_exists(clock_gettime "time.h" HAVE_CLOCK_GETTIME)
unset(CMAKE_REQUIRED_DEFINITIONS)

list(JOIN C_DIALECTS "," dialects_shown)
report("target" "${TARGET_NAME}, ${compiler_name} ${CMAKE_C_COMPILER_VERSION}, ${FLAG_SYNTAX} flag syntax,"
       "dialects ${dialects_shown}")