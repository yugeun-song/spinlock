cmake_minimum_required(VERSION 3.21)

set(ROOT_DIR "${CMAKE_CURRENT_LIST_DIR}")
include("${ROOT_DIR}/cmake/targets.cmake")

set(CONFIGS Debug Sanitize Release)
string(TOLOWER "${CONFIGS}" config_words)
set(VERBS all ${config_words} index clean-index clean distclean unused check tidy lsp-check)
set(INDEX_FILES compile_commands.json tags cscope.files cscope.out cscope.in.out cscope.po.out)
set(TOOL_OUTPUTS gmon.out perf.data perf.data.old uftrace.data uftrace.data.old core "core.[0-9]*"
    "vgcore.[0-9]*" "callgrind.out.[0-9]*" "cachegrind.out.[0-9]*" "massif.out.[0-9]*"
    "helgrind.out.[0-9]*" "drd.out.[0-9]*" .cache)
if(NOT DEFINED BUILD_SCRIPT)
    set(BUILD_SCRIPT "cmake -P build.cmake --")
endif()
unset(target CACHE)
unset(sanitize CACHE)

cmake_host_system_information(RESULT host_os QUERY OS_NAME)
cmake_host_system_information(RESULT host_arch QUERY OS_PLATFORM)
if(host_os STREQUAL "Linux")
    set(DEFAULT_TARGET ${host_arch}-linux-gcc)
elseif(host_os STREQUAL "Windows")
    set(DEFAULT_TARGET x86_64-windows-clang)
else()
    message(FATAL_ERROR "Unsupported host '${host_os}'. Build on Linux or Windows.")
endif()

set(usage [=[
usage: @BUILD_SCRIPT@ [verb ...] [target] [SANITIZE=<list>]

Configure build/<target> from its CMake preset and build into bin/<target>-<config>/.

  all          debug and sanitize (default)
  debug        Debug: -O0, full debug info, -pg, no injected hardening, no PIE
  sanitize     Sanitize: Debug with -fsanitize=<list>, address by default
  release      Release: -O2, hardened, LTO
  index        compile_commands.json, tags and cscope.out in the source root
  clean-index  remove the index files
  clean        remove every build product; configured trees stay configured
  distclean    clean, clean-index, build/, tool outputs and caches
  unused       unused diagnostics of every source (clang) and unused functions (cppcheck)
  check        build every config the target can link and run its tests
  tidy         clang-tidy over every source with the Debug flags
  lsp-check    let clangd parse every source and header and print its errors
  target       configure preset to use (default @DEFAULT_TARGET@)
  SANITIZE=    sanitizers of the Sanitize configuration, e.g. SANITIZE=address,undefined
  -h, --help   print this help

Verbs run in the order given. Words are case-insensitive, except the SANITIZE list.

@TARGETS_HELP@]=])
string(CONFIGURE "${usage}" usage @ONLY)

set(first ${CMAKE_ARGC})
math(EXPR last "${CMAKE_ARGC} - 1")
foreach(i RANGE ${last})
    if(CMAKE_ARGV${i} STREQUAL "-P")
        math(EXPR first "${i} + 2")
        break()
    elseif(CMAKE_ARGV${i} MATCHES "^-P.")
        math(EXPR first "${i} + 1")
        break()
    endif()
endforeach()
if(first LESS CMAKE_ARGC AND CMAKE_ARGV${first} STREQUAL "--")
    math(EXPR first "${first} + 1")
endif()

set(verbs "")
if(first LESS CMAKE_ARGC)
    foreach(i RANGE ${first} ${last})
        string(TOLOWER "${CMAKE_ARGV${i}}" word)
        if(word STREQUAL "-h" OR word STREQUAL "--help")
            execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${usage}")
            return()
        endif()
    endforeach()
    foreach(i RANGE ${first} ${last})
        set(arg "${CMAKE_ARGV${i}}")
        string(TOLOWER "${arg}" word)
        if(word IN_LIST VERBS)
            list(APPEND verbs ${word})
        elseif(word IN_LIST TARGETS AND NOT DEFINED target)
            set(target "${word}")
        elseif(arg MATCHES "^SANITIZE=([a-z0-9,_-]+)$" AND NOT DEFINED sanitize)
            set(sanitize "${CMAKE_MATCH_1}")
        elseif(word IN_LIST TARGETS OR word MATCHES "^sanitize=")
            message(FATAL_ERROR "'${arg}' repeats or contradicts an earlier word; see '${BUILD_SCRIPT} -h'.")
        else()
            message(FATAL_ERROR "Unknown argument '${arg}'; see '${BUILD_SCRIPT} -h'.")
        endif()
    endforeach()
endif()
if(verbs STREQUAL "")
    set(verbs all)
endif()
list(TRANSFORM verbs REPLACE "^all$" "debug;sanitize")
if(NOT DEFINED sanitize)
    set(sanitize address)
endif()
if(NOT DEFINED target)
    set(target ${DEFAULT_TARGET})
endif()
if(NOT target IN_LIST TARGETS)
    message(FATAL_ERROR "No preset named '${target}'; see '${BUILD_SCRIPT} -h'.")
endif()

function(remove_globs)
    foreach(pattern IN LISTS ARGN)
        file(GLOB matches LIST_DIRECTORIES true "${ROOT_DIR}/${pattern}")
        foreach(match IN LISTS matches)
            file(REMOVE_RECURSE "${match}")
        endforeach()
    endforeach()
endfunction()

function(index_sources out)
    execute_process(COMMAND git ls-files -- "*.c" "*.h" WORKING_DIRECTORY "${ROOT_DIR}"
                    OUTPUT_VARIABLE files RESULT_VARIABLE result ERROR_QUIET)
    if(NOT result EQUAL 0)
        file(GLOB_RECURSE files RELATIVE "${ROOT_DIR}" "${ROOT_DIR}/*.c" "${ROOT_DIR}/*.h")
        list(FILTER files EXCLUDE REGEX "^(build|bin)/")
    else()
        string(REGEX REPLACE "\n$" "" files "${files}")
        string(REPLACE "\n" ";" files "${files}")
    endif()
    set(${out} "${files}" PARENT_SCOPE)
endfunction()

function(debug_compdb out)
    file(READ "${binary_dir}/compile_commands.json" compdb)
    string(JSON count LENGTH "${compdb}")
    math(EXPR last_entry "${count} - 1")
    set(debug_entries "")
    set(all_entries "")
    foreach(i RANGE ${last_entry})
        string(JSON entry GET "${compdb}" ${i})
        string(JSON output ERROR_VARIABLE no_output GET "${entry}" output)
        string(APPEND all_entries ",\n${entry}")
        if(output MATCHES "/Debug/")
            string(APPEND debug_entries ",\n${entry}")
        endif()
    endforeach()
    if(debug_entries STREQUAL "")
        set(debug_entries "${all_entries}")
    endif()
    string(SUBSTRING "${debug_entries}" 2 -1 debug_entries)
    file(WRITE "${binary_dir}/compile_commands.debug.json" "[\n${debug_entries}\n]\n")
    set(${out} "[\n${debug_entries}\n]" PARENT_SCOPE)
endfunction()

set(configured FALSE)
macro(configure_target)
    if(NOT configured)
        if(NOT target IN_LIST TARGETS_AVAILABLE)
            message(FATAL_ERROR "Target '${target}' is unavailable: ${TARGET_PROBLEM_${target}}.")
        endif()
        preset_value(${target} binary_dir binaryDir)
        string(REPLACE "\${sourceDir}" "${ROOT_DIR}" binary_dir "${binary_dir}")
        string(REPLACE "\${presetName}" "${target}" binary_dir "${binary_dir}")
        cmake_path(ABSOLUTE_PATH binary_dir BASE_DIRECTORY "${ROOT_DIR}" NORMALIZE)
        cmake_path(IS_PREFIX binary_dir "${ROOT_DIR}" NORMALIZE contains_root)
        if(binary_dir MATCHES "\\$[a-z]*{" OR contains_root)
            message(FATAL_ERROR "Preset '${target}' has an unusable binaryDir '${binary_dir}'.")
        endif()
        preset_environment(${target})
        message(STATUS "Configuring ${target}")
        execute_process(COMMAND "${CMAKE_COMMAND}" --preset ${target} -DSANITIZE=${sanitize}
                        WORKING_DIRECTORY "${ROOT_DIR}" RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Configuring ${target} failed.")
        endif()
        file(STRINGS "${binary_dir}/CMakeCache.txt" sanitize_ok REGEX "^SANITIZE_OK:INTERNAL=")
        string(REGEX REPLACE "^SANITIZE_OK:INTERNAL=" "" sanitize_ok "${sanitize_ok}")
        set(configured TRUE)
    endif()
endmacro()

foreach(verb IN LISTS verbs)
    if(verb IN_LIST config_words)
        configure_target()
        list(FIND config_words "${verb}" index)
        list(GET CONFIGS ${index} config)
        if(config STREQUAL "Sanitize" AND NOT sanitize_ok)
            message(STATUS "Skipping Sanitize: ${target} cannot link -fsanitize=${sanitize}")
            continue()
        endif()
        message(STATUS "Building ${target} (${config})")
        execute_process(COMMAND "${CMAKE_COMMAND}" --build "${binary_dir}" --config ${config} --parallel
                        RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Building ${target} (${config}) failed.")
        endif()
        message(STATUS "Programs are in ${ROOT_DIR}/bin/${target}-${verb}")
    elseif(verb STREQUAL "index")
        configure_target()
        debug_compdb(debug_entries)
        execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different
                        "${binary_dir}/compile_commands.debug.json" "${ROOT_DIR}/compile_commands.json")
        message(STATUS "Wrote ${ROOT_DIR}/compile_commands.json")
        index_sources(sources)
        find_program(ctags_tool ctags NO_CACHE)
        find_program(cscope_tool cscope NO_CACHE)
        if(ctags_tool)
            execute_process(COMMAND "${ctags_tool}" -f tags ${sources} WORKING_DIRECTORY "${ROOT_DIR}")
            message(STATUS "Wrote ${ROOT_DIR}/tags")
        else()
            message(STATUS "ctags not found, skipped tags")
        endif()
        if(cscope_tool)
            list(JOIN sources "\n" listing)
            file(WRITE "${ROOT_DIR}/cscope.files" "${listing}\n")
            execute_process(COMMAND "${cscope_tool}" -bkqu -i cscope.files WORKING_DIRECTORY "${ROOT_DIR}")
            message(STATUS "Wrote ${ROOT_DIR}/cscope.out")
        else()
            message(STATUS "cscope not found, skipped cscope.out")
        endif()
    elseif(verb STREQUAL "unused")
        configure_target()
        debug_compdb(entries)
        find_program(clang_tool clang NO_CACHE)
        find_program(cppcheck_tool cppcheck NO_CACHE)
        string(JSON count LENGTH "${entries}")
        math(EXPR last_entry "${count} - 1")
        set(sources "")
        foreach(i RANGE ${last_entry})
            string(JSON file GET "${entries}" ${i} file)
            string(JSON command GET "${entries}" ${i} command)
            separate_arguments(words UNIX_COMMAND "${command}")
            list(FILTER words INCLUDE REGEX "^(-std=|-D|-U|-I|-isystem)")
            list(APPEND sources "${file}")
            if(clang_tool)
                execute_process(COMMAND "${clang_tool}" -fsyntax-only ${words} -Wno-everything -Wunused
                                -Wunused-parameter -Wunused-macros "${file}" WORKING_DIRECTORY "${ROOT_DIR}")
            endif()
        endforeach()
        if(NOT clang_tool)
            message(STATUS "clang not found, skipped the per-file check")
        endif()
        if(cppcheck_tool)
            execute_process(COMMAND "${cppcheck_tool}" --enable=unusedFunction --quiet
                            "--template={file}:{line}:{column}: {severity}: {message} [{id}]" ${sources}
                            WORKING_DIRECTORY "${ROOT_DIR}" OUTPUT_VARIABLE report ERROR_VARIABLE report)
            string(REGEX MATCHALL "[^\n]*\\[unusedFunction\\]" findings "${report}")
            foreach(finding IN LISTS findings)
                message("${finding}")
            endforeach()
        else()
            message(STATUS "cppcheck not found, skipped the cross-file check")
        endif()
    elseif(verb STREQUAL "check")
        configure_target()
        get_filename_component(cmake_bin_dir "${CMAKE_COMMAND}" DIRECTORY)
        foreach(config IN LISTS CONFIGS)
            if(config STREQUAL "Sanitize" AND NOT sanitize_ok)
                message(STATUS "Skipping Sanitize tests: ${target} cannot link -fsanitize=${sanitize}")
                continue()
            endif()
            execute_process(COMMAND "${CMAKE_COMMAND}" --build "${binary_dir}" --config ${config} --parallel
                            RESULT_VARIABLE result)
            if(NOT result EQUAL 0)
                message(FATAL_ERROR "Building ${target} (${config}) failed.")
            endif()
            message(STATUS "Testing ${target} (${config})")
            execute_process(COMMAND "${cmake_bin_dir}/ctest" --test-dir "${binary_dir}" -C ${config}
                            --output-on-failure RESULT_VARIABLE result)
            if(NOT result EQUAL 0)
                message(FATAL_ERROR "Tests of ${target} (${config}) failed.")
            endif()
        endforeach()
    elseif(verb STREQUAL "tidy" OR verb STREQUAL "lsp-check")
        configure_target()
        debug_compdb(entries)
        file(MAKE_DIRECTORY "${binary_dir}/debug-compdb")
        file(READ "${binary_dir}/compile_commands.debug.json" clang_compdb)
        foreach(flag -fkeep-inline-functions -fkeep-static-functions)
            string(REPLACE " ${flag}" "" clang_compdb "${clang_compdb}")
        endforeach()
        file(WRITE "${binary_dir}/debug-compdb/compile_commands.json" "${clang_compdb}")
        string(JSON count LENGTH "${entries}")
        math(EXPR last_entry "${count} - 1")
        set(sources "")
        foreach(i RANGE ${last_entry})
            string(JSON file GET "${entries}" ${i} file)
            list(APPEND sources "${file}")
        endforeach()
        if(verb STREQUAL "tidy")
            find_program(tidy_tool clang-tidy NO_CACHE)
            if(NOT tidy_tool)
                message(FATAL_ERROR "clang-tidy not found.")
            endif()
            set(checks "")
            if(NOT EXISTS "${ROOT_DIR}/.clang-tidy")
                set(checks "--checks=clang-analyzer-*,clang-diagnostic-*")
            endif()
            execute_process(COMMAND "${tidy_tool}" -p "${binary_dir}/debug-compdb" --quiet ${checks} ${sources}
                            WORKING_DIRECTORY "${ROOT_DIR}" RESULT_VARIABLE result)
            if(NOT result EQUAL 0)
                message(FATAL_ERROR "clang-tidy reported errors.")
            endif()
        else()
            find_program(clangd_tool clangd NO_CACHE)
            if(NOT clangd_tool)
                message(FATAL_ERROR "clangd not found.")
            endif()
            index_sources(all_files)
            list(FILTER all_files INCLUDE REGEX "\\.h$")
            set(errors 0)
            foreach(file IN LISTS sources all_files)
                execute_process(COMMAND "${clangd_tool}" "--compile-commands-dir=${binary_dir}/debug-compdb"
                                "--check=${file}" WORKING_DIRECTORY "${ROOT_DIR}"
                                OUTPUT_VARIABLE out ERROR_VARIABLE out)
                string(REGEX MATCHALL "E\\[[^\n]*" lines "${out}")
                list(FILTER lines EXCLUDE REGEX "tweak:|Failed to resolve URI")
                list(LENGTH lines found)
                if(found GREATER 0)
                    math(EXPR errors "${errors} + ${found}")
                    message(STATUS "${file}:")
                    foreach(line IN LISTS lines)
                        message(STATUS "  ${line}")
                    endforeach()
                endif()
            endforeach()
            if(errors GREATER 0)
                message(FATAL_ERROR "clangd reported ${errors} errors.")
            endif()
            message(STATUS "clangd parsed every source and header without errors")
        endif()
    elseif(verb STREQUAL "clean-index")
        message(STATUS "Removing the index files")
        remove_globs(${INDEX_FILES})
    elseif(verb STREQUAL "clean")
        file(GLOB trees LIST_DIRECTORIES true "${ROOT_DIR}/build" "${ROOT_DIR}/build/*")
        foreach(tree IN LISTS trees)
            if(EXISTS "${tree}/CMakeCache.txt")
                foreach(config IN LISTS CONFIGS)
                    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${tree}" --config ${config} --target clean
                                    OUTPUT_QUIET ERROR_QUIET)
                endforeach()
                message(STATUS "Cleaned ${tree}")
            endif()
        endforeach()
        file(REMOVE_RECURSE "${ROOT_DIR}/bin")
        message(STATUS "Removed ${ROOT_DIR}/bin")
    elseif(verb STREQUAL "distclean")
        message(STATUS "Removing bin/, build/, the index files, tool outputs and caches")
        file(REMOVE_RECURSE "${ROOT_DIR}/bin" "${ROOT_DIR}/build")
        remove_globs(${INDEX_FILES} ${TOOL_OUTPUTS})
    endif()
endforeach()

if(configured)
    foreach(word IN LISTS config_words)
        file(GLOB_RECURSE leftovers "${ROOT_DIR}/bin/${target}-${word}/*")
        if(leftovers STREQUAL "" AND IS_DIRECTORY "${ROOT_DIR}/bin/${target}-${word}")
            file(REMOVE_RECURSE "${ROOT_DIR}/bin/${target}-${word}")
        endif()
    endforeach()
endif()
