cmake_minimum_required(VERSION 3.21)

set(ROOT_DIR "${CMAKE_CURRENT_LIST_DIR}")
include("${ROOT_DIR}/cmake/presets.cmake")

set(CONFIGS Debug Sanitize Release)
string(TOLOWER "${CONFIGS}" config_words)
set(COMMANDS all ${config_words} index clean-index clean distclean unused check tidy clangd-check)
set(INDEX_FILES compile_commands.json tags cscope.files cscope.out cscope.in.out cscope.po.out)
set(TOOL_OUTPUTS gmon.out perf.data perf.data.old uftrace.data uftrace.data.old core "core.[0-9]*"
    "vgcore.[0-9]*" "callgrind.out.[0-9]*" "cachegrind.out.[0-9]*" "massif.out.[0-9]*"
    "helgrind.out.[0-9]*" "drd.out.[0-9]*" .cache)
set(NOT_PROGRAMS "\\.(pdb|ilk|lib|exp)$")
set(ALL_debug debug sanitize)
set(ALL_release release)
if(NOT DEFINED BUILD_SCRIPT)
    set(BUILD_SCRIPT "cmake -P build.cmake --")
endif()
unset(preset CACHE)
unset(sanitize CACHE)
unset(profile CACHE)

cmake_host_system_information(RESULT host_os QUERY OS_NAME)
cmake_host_system_information(RESULT host_arch QUERY OS_PLATFORM)
if(host_os STREQUAL "Linux")
    set(DEFAULT_PRESET ${host_arch}-linux-gcc)
elseif(host_os STREQUAL "Windows")
    set(DEFAULT_PRESET x86_64-windows-clang)
else()
    message(FATAL_ERROR "unsupported host '${host_os}'; build on Linux or Windows")
endif()

set(help_hint "${BUILD_SCRIPT} -h")

set(usage [=[
usage: @BUILD_SCRIPT@ [command ...] [preset] [VARIABLE=value ...]

commands:
  all           the debug and sanitize builds, or the release build with PROFILE=release
  debug         -O0, full debug info, -pg, no default hardening, no PIE
  sanitize      the debug flags plus -fsanitize=SANITIZE
  release       -O2, hardened, PIE, link-time optimization (LTO)
  index         compile_commands.json with the PROFILE flags, tags and cscope.out
  clean-index   remove compile_commands.json, tags and cscope.*
  clean         remove bin/ and the build products of every configured tree in build/
  distclean     clean, clean-index, build/, tool outputs and .cache/
  unused        unused diagnostics of every source (clang) and unused functions (cppcheck)
  check         build every mode the preset can link and run its tests
  tidy          clang-tidy over every source with the PROFILE flags
  clangd-check  clangd parses every source and header and prints its errors
  -h, --help    print this help

variables:
  PROFILE=debug|release  what all builds and the flags of index, unused, tidy, clangd-check (default debug)
  SANITIZE=<list>        sanitizers of the sanitize build, comma separated (default address)
  <preset>               configure preset to build (default @DEFAULT_PRESET@)

@PRESETS_HELP@

Each mode builds into bin/<preset>-<mode>/ from build/<preset>/, where <preset> is named
<arch>-<os>-<cc>, for example bin/@DEFAULT_PRESET@-debug/. Commands run in the order given; arguments are case-insensitive, except the SANITIZE list.]=])
string(CONFIGURE "${usage}" usage @ONLY)

function(say text)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "=> ${text}")
endfunction()

function(echo_line text)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${text}")
endfunction()

function(count_text out count singular plural)
    if(count EQUAL 1)
        set(${out} "1 ${singular}" PARENT_SCOPE)
    else()
        set(${out} "${count} ${plural}" PARENT_SCOPE)
    endif()
endfunction()

set(first ${CMAKE_ARGC})
math(EXPR last "${CMAKE_ARGC} - 1")
foreach(i RANGE ${last})
    if(CMAKE_ARGV${i} STREQUAL "-P")
        math(EXPR first "${i} + 2")
        break()
    elseif(CMAKE_ARGV${i} MATCHES "^-P.")
        math(EXPR first "${i} + 1")
        break()
    endif()
endforeach()
if(first LESS CMAKE_ARGC AND CMAKE_ARGV${first} STREQUAL "--")
    math(EXPR first "${first} + 1")
endif()

set(commands "")
if(first LESS CMAKE_ARGC)
    foreach(i RANGE ${first} ${last})
        string(TOLOWER "${CMAKE_ARGV${i}}" word)
        if(word STREQUAL "-h" OR word STREQUAL "--help" OR word STREQUAL "help")
            echo_line("${usage}")
            return()
        endif()
    endforeach()
    foreach(i RANGE ${first} ${last})
        set(arg "${CMAKE_ARGV${i}}")
        string(TOLOWER "${arg}" word)
        if(word IN_LIST COMMANDS)
            list(APPEND commands ${word})
        elseif(word IN_LIST PRESETS AND NOT DEFINED preset)
            set(preset "${word}")
        elseif(arg MATCHES "^SANITIZE=([a-z0-9,_-]+)$" AND NOT DEFINED sanitize)
            set(sanitize "${CMAKE_MATCH_1}")
        elseif(word MATCHES "^profile=(.*)$" AND NOT DEFINED profile)
            set(profile "${CMAKE_MATCH_1}")
            if(NOT profile MATCHES "^(debug|release)$")
                message(FATAL_ERROR "PROFILE takes debug or release, not '${profile}'")
            endif()
        elseif(word IN_LIST PRESETS OR word MATCHES "^(sanitize|profile)=")
            message(FATAL_ERROR "'${arg}' repeats or contradicts an earlier word; see '${help_hint}'")
        else()
            message(FATAL_ERROR "unknown argument '${arg}'; see '${help_hint}'")
        endif()
    endforeach()
endif()
if(commands STREQUAL "")
    set(commands all)
endif()
if(NOT DEFINED profile)
    set(profile debug)
endif()
list(FIND config_words "${profile}" profile_index)
list(GET CONFIGS ${profile_index} profile_config)
list(TRANSFORM commands REPLACE "^all$" "${ALL_${profile}}")
if(NOT DEFINED sanitize)
    set(sanitize address)
endif()
if(NOT DEFINED preset)
    set(preset ${DEFAULT_PRESET})
endif()
if(NOT preset IN_LIST PRESETS)
    message(FATAL_ERROR "no preset named '${preset}'; see '${help_hint}'")
endif()

function(remove_globs)
    foreach(pattern IN LISTS ARGN)
        file(GLOB matches LIST_DIRECTORIES true "${ROOT_DIR}/${pattern}")
        foreach(match IN LISTS matches)
            file(REMOVE_RECURSE "${match}")
        endforeach()
    endforeach()
endfunction()

function(index_sources out)
    execute_process(COMMAND git ls-files -- "*.c" "*.h" WORKING_DIRECTORY "${ROOT_DIR}"
                    OUTPUT_VARIABLE files RESULT_VARIABLE result ERROR_QUIET)
    if(NOT result EQUAL 0)
        file(GLOB_RECURSE files RELATIVE "${ROOT_DIR}" "${ROOT_DIR}/*.c" "${ROOT_DIR}/*.h")
        list(FILTER files EXCLUDE REGEX "^(build|bin)/")
    else()
        string(REGEX REPLACE "\n$" "" files "${files}")
        string(REPLACE "\n" ";" files "${files}")
    endif()
    set(${out} "${files}" PARENT_SCOPE)
endfunction()

function(profile_compdb out)
    if(NOT EXISTS "${binary_dir}/compile_commands.json")
        message(FATAL_ERROR "${binary_dir_rel} has no compile_commands.json; the generator of ${preset} writes none")
    endif()
    file(READ "${binary_dir}/compile_commands.json" compdb)
    string(JSON count LENGTH "${compdb}")
    math(EXPR last_entry "${count} - 1")
    set(kept "")
    foreach(i RANGE ${last_entry})
        string(JSON entry GET "${compdb}" ${i})
        string(JSON output ERROR_VARIABLE no_output GET "${entry}" output)
        if(output MATCHES "/${profile_config}/")
            string(APPEND kept ",\n${entry}")
        endif()
    endforeach()
    if(kept STREQUAL "")
        message(FATAL_ERROR "${binary_dir_rel}/compile_commands.json has no ${profile} entries")
    endif()
    string(SUBSTRING "${kept}" 2 -1 kept)
    file(WRITE "${binary_dir}/compile_commands.${profile}.json" "[\n${kept}\n]\n")
    set(${out} "[\n${kept}\n]" PARENT_SCOPE)
endfunction()

set(configured FALSE)
macro(configure_preset)
    if(NOT configured)
        if(NOT preset IN_LIST PRESETS_AVAILABLE)
            message(FATAL_ERROR "preset '${preset}' is unavailable: ${PRESET_PROBLEM_${preset}}")
        endif()
        preset_value(${preset} binary_dir binaryDir)
        string(REPLACE "\${sourceDir}" "${ROOT_DIR}" binary_dir "${binary_dir}")
        string(REPLACE "\${presetName}" "${preset}" binary_dir "${binary_dir}")
        cmake_path(ABSOLUTE_PATH binary_dir BASE_DIRECTORY "${ROOT_DIR}" NORMALIZE)
        cmake_path(IS_PREFIX binary_dir "${ROOT_DIR}" NORMALIZE contains_root)
        if(binary_dir MATCHES "\\$[a-z]*{" OR contains_root)
            message(FATAL_ERROR "preset '${preset}' has an unusable binaryDir '${binary_dir}'")
        endif()
        file(RELATIVE_PATH binary_dir_rel "${ROOT_DIR}" "${binary_dir}")
        preset_environment(${preset})
        preset_value(${preset} generator generator)
        set(verbose "")
        if(generator MATCHES "^Ninja")
            set(verbose -- -v)
        endif()
        set(cached_sanitize "")
        if(EXISTS "${binary_dir}/CMakeCache.txt")
            file(STRINGS "${binary_dir}/CMakeCache.txt" cached_sanitize REGEX "^SANITIZE:STRING=")
            string(REGEX REPLACE "^SANITIZE:STRING=" "" cached_sanitize "${cached_sanitize}")
        endif()
        if(NOT cached_sanitize STREQUAL sanitize OR NOT EXISTS "${binary_dir}/CMakeFiles/cmake.check_cache"
           OR "${ROOT_DIR}/CMakePresets.json" IS_NEWER_THAN "${binary_dir}/CMakeCache.txt")
            execute_process(COMMAND "${CMAKE_COMMAND}" --preset ${preset} -DSANITIZE=${sanitize} --log-level=NOTICE
                            WORKING_DIRECTORY "${ROOT_DIR}" OUTPUT_VARIABLE configure_log ERROR_VARIABLE configure_log
                            RESULT_VARIABLE result)
            string(REGEX REPLACE "(^|\n)(Preset CMake variables|Preset environment variables):\n\n([^\n]+\n)*\n" "\\1"
                   configure_log "${configure_log}")
            string(REGEX REPLACE "(^|\n)-- (Configuring done|Generating done|Build files have been written to)[^\n]*" ""
                   configure_log "${configure_log}")
            string(STRIP "${configure_log}" configure_log)
            if(NOT configure_log STREQUAL "")
                echo_line("${configure_log}")
            endif()
            if(NOT result EQUAL 0)
                message(FATAL_ERROR "configuring ${preset} failed")
            endif()
        endif()
        file(STRINGS "${binary_dir}/CMakeCache.txt" sanitize_ok REGEX "^SANITIZE_OK:INTERNAL=")
        string(REGEX REPLACE "^SANITIZE_OK:INTERNAL=" "" sanitize_ok "${sanitize_ok}")
        set(configured TRUE)
    endif()
endmacro()

macro(build_config config word)
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${binary_dir}" --config ${config} --parallel ${verbose}
                    RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "building ${preset} (${word}) failed")
    endif()
endmacro()

foreach(command IN LISTS commands)
    if(command IN_LIST config_words)
        configure_preset()
        list(FIND config_words "${command}" index)
        list(GET CONFIGS ${index} config)
        set(label "${command}")
        if(config STREQUAL "Sanitize")
            set(label "sanitize (${sanitize})")
            if(NOT sanitize_ok)
                say("${label}: skipped, ${preset} cannot link -fsanitize=${sanitize}")
                continue()
            endif()
        endif()
        build_config(${config} ${command})
        file(GLOB_RECURSE programs LIST_DIRECTORIES false "${ROOT_DIR}/bin/${preset}-${command}/*")
        list(FILTER programs EXCLUDE REGEX "${NOT_PROGRAMS}")
        list(LENGTH programs program_count)
        count_text(programs_text ${program_count} program programs)
        say("${label}: ${programs_text} in bin/${preset}-${command}/")
    elseif(command STREQUAL "index")
        configure_preset()
        profile_compdb(entries)
        string(JSON entry_count LENGTH "${entries}")
        count_text(entries_text ${entry_count} entry entries)
        set(state written)
        if(EXISTS "${ROOT_DIR}/compile_commands.json")
            file(SHA256 "${ROOT_DIR}/compile_commands.json" old_hash)
            file(SHA256 "${binary_dir}/compile_commands.${profile}.json" new_hash)
            if(old_hash STREQUAL new_hash)
                set(state unchanged)
            endif()
        endif()
        file(COPY_FILE "${binary_dir}/compile_commands.${profile}.json" "${ROOT_DIR}/compile_commands.json"
             ONLY_IF_DIFFERENT)
        say("compile_commands.json: ${entries_text} with the ${profile} flags, ${state}")
        index_sources(sources)
        list(LENGTH sources source_count)
        count_text(files_text ${source_count} file files)
        find_program(ctags_tool ctags NO_CACHE)
        find_program(cscope_tool cscope NO_CACHE)
        if(ctags_tool)
            execute_process(COMMAND "${ctags_tool}" -f tags ${sources} WORKING_DIRECTORY "${ROOT_DIR}")
            say("tags: ${files_text}")
        else()
            say("tags: skipped, ctags not found")
        endif()
        if(cscope_tool)
            list(JOIN sources "\n" listing)
            file(WRITE "${ROOT_DIR}/cscope.files" "${listing}\n")
            execute_process(COMMAND "${cscope_tool}" -bkqu -i cscope.files WORKING_DIRECTORY "${ROOT_DIR}")
            say("cscope.out: ${files_text}")
        else()
            say("cscope.out: skipped, cscope not found")
        endif()
    elseif(command STREQUAL "unused")
        configure_preset()
        profile_compdb(entries)
        find_program(clang_tool clang NO_CACHE)
        find_program(cppcheck_tool cppcheck NO_CACHE)
        string(JSON entry_count LENGTH "${entries}")
        count_text(sources_text ${entry_count} source sources)
        if(clang_tool)
            set(checks "-Wunused -Wunused-parameter -Wunused-macros")
            say("unused (clang): ${checks} over ${sources_text} with the ${profile} definitions")
        else()
            say("unused (clang): skipped, clang not found")
        endif()
        math(EXPR last_entry "${entry_count} - 1")
        set(sources "")
        set(cppcheck_standard "")
        foreach(i RANGE ${last_entry})
            string(JSON file GET "${entries}" ${i} file)
            string(JSON compile_command GET "${entries}" ${i} command)
            separate_arguments(words UNIX_COMMAND "${compile_command}")
            foreach(word IN LISTS words)
                if(word MATCHES "^-std=(c|gnu)([0-9]+)$")
                    set(cppcheck_standard "--std=c${CMAKE_MATCH_2}")
                endif()
            endforeach()
            list(FILTER words INCLUDE REGEX "^(-std=|-D|-U|-I|-isystem)")
            list(APPEND sources "${file}")
            if(clang_tool)
                execute_process(COMMAND "${clang_tool}" -fsyntax-only ${words} -Wno-everything -Wunused
                                -Wunused-parameter -Wunused-macros "${file}" WORKING_DIRECTORY "${ROOT_DIR}")
            endif()
        endforeach()
        if(cppcheck_tool)
            say("unused (cppcheck): unusedFunction over ${sources_text}")
            execute_process(COMMAND "${cppcheck_tool}" ${cppcheck_standard} --enable=unusedFunction --quiet
                            "--template={file}:{line}:{column}: {severity}: {message} [{id}]" ${sources}
                            WORKING_DIRECTORY "${ROOT_DIR}" OUTPUT_VARIABLE report ERROR_VARIABLE report)
            string(REGEX MATCHALL "[^\n]*\\[unusedFunction\\]" findings "${report}")
            foreach(finding IN LISTS findings)
                echo_line("${finding}")
            endforeach()
        else()
            say("unused (cppcheck): skipped, cppcheck not found")
        endif()
    elseif(command STREQUAL "check")
        configure_preset()
        get_filename_component(cmake_bin_dir "${CMAKE_COMMAND}" DIRECTORY)
        set(passed "")
        foreach(config IN LISTS CONFIGS)
            string(TOLOWER "${config}" word)
            if(config STREQUAL "Sanitize" AND NOT sanitize_ok)
                say("check (sanitize): skipped, ${preset} cannot link -fsanitize=${sanitize}")
                continue()
            endif()
            build_config(${config} ${word})
            execute_process(COMMAND "${cmake_bin_dir}/ctest" --test-dir "${binary_dir}" -C ${config} -N
                            OUTPUT_VARIABLE listing)
            string(REGEX MATCH "Total Tests: ([0-9]+)" ignored "${listing}")
            set(test_count "${CMAKE_MATCH_1}")
            if(test_count STREQUAL "" OR test_count EQUAL 0)
                say("check (${word}): no tests defined")
                continue()
            endif()
            count_text(tests_text ${test_count} test tests)
            say("check (${word}): ctest runs ${tests_text} in ${binary_dir_rel}/")
            execute_process(COMMAND "${cmake_bin_dir}/ctest" --test-dir "${binary_dir}" -C ${config}
                            --output-on-failure RESULT_VARIABLE result)
            if(NOT result EQUAL 0)
                message(FATAL_ERROR "tests of ${preset} (${word}) failed")
            endif()
            list(APPEND passed ${word})
        endforeach()
        if(passed)
            list(JOIN passed ", " passed_text)
            say("check: the ${passed_text} tests passed")
        else()
            say("check: built every mode, no tests to run")
        endif()
    elseif(command STREQUAL "tidy" OR command STREQUAL "clangd-check")
        configure_preset()
        profile_compdb(entries)
        set(clang_dir "${binary_dir}/${profile}-compdb")
        file(MAKE_DIRECTORY "${clang_dir}")
        file(READ "${binary_dir}/compile_commands.${profile}.json" clang_compdb)
        foreach(flag -fkeep-inline-functions -fkeep-static-functions)
            string(REPLACE " ${flag}" "" clang_compdb "${clang_compdb}")
        endforeach()
        file(WRITE "${clang_dir}/compile_commands.json" "${clang_compdb}")
        string(JSON entry_count LENGTH "${entries}")
        math(EXPR last_entry "${entry_count} - 1")
        set(sources "")
        foreach(i RANGE ${last_entry})
            string(JSON file GET "${entries}" ${i} file)
            list(APPEND sources "${file}")
        endforeach()
        if(command STREQUAL "tidy")
            find_program(tidy_tool clang-tidy NO_CACHE)
            if(NOT tidy_tool)
                message(FATAL_ERROR "clang-tidy not found")
            endif()
            set(checks "")
            set(checks_text "the checks of .clang-tidy")
            if(NOT EXISTS "${ROOT_DIR}/.clang-tidy")
                set(checks "--checks=clang-analyzer-*,clang-diagnostic-*")
                set(checks_text "clang-analyzer-* and clang-diagnostic-*")
            endif()
            count_text(sources_text ${entry_count} source sources)
            say("tidy: ${checks_text} over ${sources_text} with the ${profile} flags")
            execute_process(COMMAND "${tidy_tool}" -p "${clang_dir}" --quiet ${checks} ${sources}
                            WORKING_DIRECTORY "${ROOT_DIR}" RESULT_VARIABLE result)
            if(NOT result EQUAL 0)
                message(FATAL_ERROR "clang-tidy reported errors")
            endif()
            say("tidy: no errors")
        else()
            find_program(clangd_tool clangd NO_CACHE)
            if(NOT clangd_tool)
                message(FATAL_ERROR "clangd not found")
            endif()
            index_sources(all_files)
            list(FILTER all_files INCLUDE REGEX "\\.h$")
            list(LENGTH all_files header_count)
            math(EXPR file_count "${entry_count} + ${header_count}")
            count_text(files_text ${file_count} file files)
            say("clangd-check: clangd over ${files_text} with the ${profile} flags")
            set(errors 0)
            foreach(file IN LISTS sources all_files)
                execute_process(COMMAND "${clangd_tool}" "--compile-commands-dir=${clang_dir}"
                                "--check=${file}" WORKING_DIRECTORY "${ROOT_DIR}"
                                OUTPUT_VARIABLE out ERROR_VARIABLE out)
                string(REGEX MATCHALL "E\\[[^\n]*" lines "${out}")
                list(FILTER lines EXCLUDE REGEX "tweak:|Failed to resolve URI")
                list(LENGTH lines found)
                if(found GREATER 0)
                    math(EXPR errors "${errors} + ${found}")
                    echo_line("${file}:")
                    foreach(line IN LISTS lines)
                        echo_line("  ${line}")
                    endforeach()
                endif()
            endforeach()
            if(errors GREATER 0)
                message(FATAL_ERROR "clangd reported ${errors} errors")
            endif()
            say("clangd-check: no errors")
        endif()
    elseif(command STREQUAL "clean-index")
        remove_globs(${INDEX_FILES})
        say("clean-index: removed compile_commands.json, tags and cscope.*")
    elseif(command STREQUAL "clean")
        file(GLOB trees LIST_DIRECTORIES true "${ROOT_DIR}/build" "${ROOT_DIR}/build/*")
        foreach(tree IN LISTS trees)
            if(EXISTS "${tree}/CMakeCache.txt")
                foreach(config IN LISTS CONFIGS)
                    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${tree}" --config ${config} --target clean
                                    OUTPUT_QUIET ERROR_QUIET)
                endforeach()
                file(RELATIVE_PATH tree_rel "${ROOT_DIR}" "${tree}")
                say("clean: removed the build products of ${tree_rel}/")
            endif()
        endforeach()
        file(REMOVE_RECURSE "${ROOT_DIR}/bin")
        say("clean: removed bin/")
    elseif(command STREQUAL "distclean")
        file(REMOVE_RECURSE "${ROOT_DIR}/bin" "${ROOT_DIR}/build")
        remove_globs(${INDEX_FILES} ${TOOL_OUTPUTS})
        set(removed "bin/, build/, compile_commands.json, tags, cscope.*, tool outputs")
        string(APPEND removed " (gmon.out, perf.data, uftrace.data, core, valgrind) and .cache/")
        say("distclean: removed ${removed}")
    endif()
endforeach()

if(configured AND EXISTS "${ROOT_DIR}/compile_commands.json" AND NOT "index" IN_LIST commands)
    profile_compdb(entries)
    file(SHA256 "${ROOT_DIR}/compile_commands.json" old_hash)
    file(SHA256 "${binary_dir}/compile_commands.${profile}.json" new_hash)
    if(NOT old_hash STREQUAL new_hash)
        file(COPY_FILE "${binary_dir}/compile_commands.${profile}.json" "${ROOT_DIR}/compile_commands.json")
        string(JSON entry_count LENGTH "${entries}")
        count_text(entries_text ${entry_count} entry entries)
        say("compile_commands.json: ${entries_text} with the ${profile} flags, written")
    endif()
endif()

if(configured)
    foreach(word IN LISTS config_words)
        file(GLOB_RECURSE leftovers "${ROOT_DIR}/bin/${preset}-${word}/*")
        if(leftovers STREQUAL "" AND IS_DIRECTORY "${ROOT_DIR}/bin/${preset}-${word}")
            file(REMOVE_RECURSE "${ROOT_DIR}/bin/${preset}-${word}")
        endif()
    endforeach()
endif()
