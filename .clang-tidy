# clangd reads this file too, so 'make tidy' and the editor run the same checks.
# Removed checks are noise on this code base, not bugs: printf return values
# (cert-err33-c), getopt/strtol/exit flagged as not thread-safe from a
# single-threaded main (concurrency-mt-unsafe), the '#if defined(...)' chains
# that keep '#elif' legible (use-concise-preprocessor-directives), and clangd
# already runs its own include cleaner, and inline assembly is what this code
# studies (no-assembler). Two checks contradict the coding style:
# a const parameter keeps its const in the declaration (avoid-const-params-in-decls),
# and only tables that grow end with a comma (trailing-comma).
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  misc-*,
  performance-*,
  portability-*,
  -portability-no-assembler,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -cert-dcl37-c,
  -cert-dcl51-cpp,
  -cert-err33-c,
  -concurrency-mt-unsafe,
  -misc-include-cleaner,
  -readability-braces-around-statements,
  -readability-function-cognitive-complexity,
  -readability-identifier-length,
  -readability-avoid-const-params-in-decls,
  -readability-magic-numbers,
  -readability-trailing-comma,
  -readability-use-concise-preprocessor-directives
WarningsAsErrors: ''
HeaderFilterRegex: '.*'
CheckOptions:
  bugprone-reserved-identifier.AllowedIdentifiers: '_GNU_SOURCE;_POSIX_C_SOURCE;_DEFAULT_SOURCE'
FormatStyle: file
